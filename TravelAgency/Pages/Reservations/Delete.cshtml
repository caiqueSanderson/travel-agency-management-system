@page
@model TravelAgency.Pages.Reservations.DeleteModel

@{
	ViewData["Title"] = "Excluir Reserva";
}

<div class="card">
	<h1>Excluir Reserva</h1>

	<h4>Você tem certeza que deseja excluir este destino?</h4>
	<hr />

	<dl class="row">
		<dt class="col-sm-2">
			Cliente
		</dt>
		<dd class="col-sm-10">
			@Model.Reservation.Client.Name
		</dd>
		<dt class="col-sm-2">
			Pacote Turístico
		</dt>
		<dd class="col-sm-10">
			@Model.Reservation.TourPackage.Title
		</dd>
		<dt class="col-sm-2">
			Data da Reserva
		</dt>
		<dd class="col-sm-10">
			@Model.Reservation.ReservationDate.ToString("dd/MM/yyyy")
		</dd>
	</dl>

	<form method="post">
		<input type="hidden" asp-for="Reservation.Id" />

		<button type="submit" class="btn btn-danger">
			<i class="bi bi-trash"></i> Confirmar Exclusão
		</button>

		<a asp-page="./Index" class="btn btn-secondary">
			Cancelar
		</a>
	</form>
</div>
